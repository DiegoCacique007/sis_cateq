APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Producción: LOG_STACK=daily y LOG_LEVEL=warning (ver docs/despliegue.md).

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Contraseña inicial de la cuenta de Secretaría creada por UsuariosParroquiaSeeder.
# Obligatoria para ejecutar db:seed (mínimo 12 caracteres). No la incluyas en el repositorio.
# El seeder solo crea la cuenta si no existe; nunca modifica una cuenta existente.
SEED_SECRETARIA_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción: SESSION_ENCRYPT=true. La cookie es segura por defecto si APP_URL usa https;
# defínela solo para forzar otro valor.
# SESSION_SECURE_COOKIE=true

# IP del proxy inverso o balanceador delante del servidor (lista separada por comas).
# Déjala sin definir si no hay proxy. Nunca "*" si el servidor es accesible directamente.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Producción: un transporte real (por ejemplo smtp). Con "log" los enlaces de
# recuperación de contraseña solo se escriben en el log y no llegan a nadie.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Clasificador de intenciones del chatbot (ver docs/despliegue.md §14). Por defecto, off: solo reglas.
# Un proveedor remoto recibiría el texto que escriben los usuarios: requiere una decisión explícita.
# CHATBOT_CLASSIFIER_MODE=off
# CHATBOT_CLASSIFIER_DRIVER=none
# CHATBOT_CLASSIFIER_TIMEOUT=8
# CHATBOT_OLLAMA_URL=http://localhost:11434
# CHATBOT_OLLAMA_MODEL=hf.co/Mungert/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
# CHATBOT_OLLAMA_KEEP_ALIVE=10m

VITE_APP_NAME="${APP_NAME}"
